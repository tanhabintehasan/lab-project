generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                 @id @default(cuid())
  email                String?                @unique
  phone                String?                @unique
  passwordHash         String
  name                 String
  avatar               String?
  role                 UserRole               @default(CUSTOMER)
  status               UserStatus             @default(ACTIVE)
  locale               String                 @default("zh-CN")
  emailVerified        Boolean                @default(false)
  phoneVerified        Boolean                @default(false)
  lastLoginAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  addresses            Address[]
  auditLogs            AuditLog[]
  Certificate          Certificate[]
  CertificateDownload  CertificateDownload[]
  company              CompanyMembership?
  CustomTestingRequest CustomTestingRequest[]
  equipmentBookings    EquipmentBooking[]
  favorites            Favorite[]
  invoiceProfiles      InvoiceProfile[]
  labUser              LabUser?
  messages             Message[]
  notifications        Notification[]
  orders               Order[]
  passwordResetTokens  PasswordResetToken[]
  quotations           Quotation[]
  rfqRequests          RFQRequest[]
  referredBy           Referral?              @relation("ReferredUser")
  referrals            Referral[]             @relation("ReferrerUser")
  referralCode         ReferralCode?
  reportDownloads      ReportDownload[]
  RewardApplication    RewardApplication[]
  sessions             Session[]
  technicianTasks      TechnicianTask[]
  wallet               Wallet?
  withdrawalRequests   WithdrawalRequest[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Session {
  id                 String    @id @default(cuid())
  userId             String
  token              String    @unique
  expiresAt          DateTime
  ipAddress          String?
  userAgent          String?
  csrfToken          String?
  csrfTokenExpiresAt DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token])
  @@index([userId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String?
  name       String
  phone      String
  province   String
  city       String
  district   String
  street     String
  postalCode String?
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders     Order[]

  @@index([userId])
}

model InvoiceProfile {
  id          String    @id @default(cuid())
  userId      String
  companyName String
  taxNumber   String
  bankName    String?
  bankAccount String?
  address     String?
  phone       String?
  isDefault   Boolean   @default(false)
  invoices    Invoice[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model Company {
  id               String              @id @default(cuid())
  name             String
  registrationNo   String?
  industry         String?
  size             String?
  address          String?
  contactPerson    String?
  contactPhone     String?
  contactEmail     String?
  logo             String?
  businessLicense  String?
  status           CompanyStatus       @default(PENDING)
  contractPricing  Boolean             @default(false)
  billingEnabled   Boolean             @default(false)
  approvalRequired Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt
  members          CompanyMembership[]
  wallet           CompanyWallet?

  @@index([name])
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([companyId])
}

model ServiceCategory {
  id         String            @id @default(cuid())
  slug       String            @unique
  nameZh     String
  nameEn     String?
  descZh     String?
  descEn     String?
  icon       String?
  image      String?
  parentId   String?
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  seoTitleZh String?
  seoTitleEn String?
  seoDescZh  String?
  seoDescEn  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt
  parent     ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onUpdate: NoAction)
  children   ServiceCategory[] @relation("CategoryTree")
  services   TestingService[]

  @@index([parentId])
}

model Material {
  id        String            @id @default(cuid())
  slug      String            @unique
  nameZh    String
  nameEn    String?
  descZh    String?
  descEn    String?
  icon      String?
  image     String?
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  services  ServiceMaterial[]
}

model Industry {
  id        String            @id @default(cuid())
  slug      String            @unique
  nameZh    String
  nameEn    String?
  descZh    String?
  descEn    String?
  icon      String?
  image     String?
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  services  ServiceIndustry[]
}

model TestingStandard {
  id           String            @id @default(cuid())
  code         String            @unique
  nameZh       String
  nameEn       String?
  organization String?
  descZh       String?
  descEn       String?
  isActive     Boolean           @default(true)
  services     ServiceStandard[]
}

model TestingService {
  id                String            @id @default(cuid())
  slug              String            @unique
  categoryId        String
  nameZh            String
  nameEn            String?
  shortDescZh       String?
  shortDescEn       String?
  fullDescZh        String?
  fullDescEn        String?
  pricingModel      PricingModel      @default(FIXED)
  priceMin          Decimal?          @db.Decimal(12, 2)
  priceMax          Decimal?          @db.Decimal(12, 2)
  currency          String            @default("CNY")
  turnaroundDays    Int?
  turnaroundDesc    String?
  sampleRequirement String?
  sampleCount       String?
  sampleSize        String?
  sampleWeight      String?
  sampleCondition   String?
  samplePreservation String?
  samplePreparation String?
  deliverables      String?
  isActive          Boolean           @default(true)
  isFeatured        Boolean           @default(false)
  isHot             Boolean           @default(false)
  sortOrder         Int               @default(0)
  seoTitleZh        String?
  seoTitleEn        String?
  seoDescZh         String?
  seoDescEn         String?
  viewCount         Int               @default(0)
  orderCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  favorites         Favorite[]
  labServices       LabService[]
  orderItems        OrderItem[]
  industries        ServiceIndustry[]
  materials         ServiceMaterial[]
  standards         ServiceStandard[]
  category          ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customFields      TestingServiceCustomField[]
  BundleServices    BundleServices[]

  @@index([categoryId])
  @@index([isActive, isFeatured], map: "TestingService_active_featured_idx")
}

model TestingServiceCustomField {
  id          String       @id @default(cuid())
  serviceId   String
  label       String
  fieldType   String       @default("TEXT")
  options     String?
  isRequired  Boolean      @default(false)
  placeholder String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  service     TestingService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([serviceId])
}

model ServiceMaterial {
  serviceId  String
  materialId String
  material   Material       @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service    TestingService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([serviceId, materialId])
}

model ServiceIndustry {
  serviceId  String
  industryId String
  industry   Industry       @relation(fields: [industryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service    TestingService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([serviceId, industryId])
}

model ServiceStandard {
  serviceId  String
  standardId String
  service    TestingService  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  standard   TestingStandard @relation(fields: [standardId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([serviceId, standardId])
}

model ServiceBundle {
  id             String           @id @default(cuid())
  slug           String           @unique
  nameZh         String
  nameEn         String?
  descZh         String?
  descEn         String?
  price          Decimal?         @db.Decimal(12, 2)
  discount       Decimal?         @db.Decimal(5, 2)
  isActive       Boolean          @default(true)
  BundleServices BundleServices[]
}

model Favorite {
  id        String         @id @default(cuid())
  userId    String
  serviceId String
  createdAt DateTime       @default(now())
  service   TestingService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, serviceId])
}

model RFQRequest {
  id            String       @id @default(cuid())
  requestNo     String       @unique
  userId        String
  title         String
  materialDesc  String?
  productType   String?
  testingTarget String?
  issue         String?
  standardReq   String?
  quantity      String?
  deadline      DateTime?
  budget        String?
  notes         String?
  status        RFQStatus    @default(SUBMITTED)
  assignedTo    String?
  assignedLabId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  quotations    Quotation[]
  files         RFQFile[]
  messages      RFQMessage[]
  lab           Laboratory?  @relation(fields: [assignedLabId], references: [id], onUpdate: NoAction)
  user          User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([status])
}

model RFQFile {
  id         String     @id @default(cuid())
  rfqId      String
  fileName   String
  fileUrl    String
  fileType   String?
  fileSize   Int?
  version    Int        @default(1)
  uploadedAt DateTime   @default(now())
  rfq        RFQRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model RFQMessage {
  id         String     @id @default(cuid())
  rfqId      String
  senderId   String
  content    String
  isInternal Boolean    @default(false)
  createdAt  DateTime   @default(now())
  rfq        RFQRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Quotation {
  id                   String                 @id @default(cuid())
  quotationNo          String                 @unique
  rfqId                String?
  userId               String
  title                String
  items                Json
  totalAmount          Decimal                @db.Decimal(12, 2)
  currency             String                 @default("CNY")
  validUntil           DateTime?
  notes                String?
  termsZh              String?
  termsEn              String?
  status               QuotationStatus        @default(DRAFT)
  version              Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  CustomTestingRequest CustomTestingRequest[]
  Order                Order[]
  rfq                  RFQRequest?            @relation(fields: [rfqId], references: [id], onUpdate: NoAction)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions            QuotationRevision[]

  @@index([rfqId])
  @@index([userId])
}

model QuotationRevision {
  id          String    @id @default(cuid())
  quotationId String
  version     Int
  items       Json
  totalAmount Decimal   @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Order {
  id            String          @id @default(cuid())
  orderNo       String          @unique
  userId        String
  addressId     String?
  status        OrderStatus     @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus   @default(UNPAID)
  totalAmount   Decimal         @db.Decimal(12, 2)
  paidAmount    Decimal         @default(0) @db.Decimal(12, 2)
  currency      String          @default("CNY")
  notes         String?
  assignedLabId String?
  assignedTo    String?
  quotationId   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  Certificate   Certificate[]
  Commission    Commission[]
  invoices      Invoice[]
  address       Address?        @relation(fields: [addressId], references: [id], onUpdate: NoAction)
  lab           Laboratory?     @relation(fields: [assignedLabId], references: [id], onUpdate: NoAction)
  Quotation     Quotation?      @relation(fields: [quotationId], references: [id], onUpdate: NoAction)
  user          User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents     OrderDocument[]
  items         OrderItem[]
  timeline      OrderTimeline[]
  payments      Payment[]
  reports       Report[]
  samples       Sample[]

  @@index([userId])
  @@index([orderNo])
  @@index([status])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  serviceId String
  quantity  Int            @default(1)
  unitPrice Decimal        @db.Decimal(12, 2)
  subtotal  Decimal        @db.Decimal(12, 2)
  notes     String?
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service   TestingService @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model OrderTimeline {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  title       String
  description String?
  operator    String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model OrderDocument {
  id         String   @id @default(cuid())
  orderId    String
  fileName   String
  fileUrl    String
  fileType   String?
  fileSize   Int?
  uploadedBy String
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Sample {
  id           String           @id @default(cuid())
  sampleNo     String           @unique
  orderId      String
  name         String
  description  String?
  materialType String?
  quantity     String?
  condition    String?
  status       SampleStatus     @default(PENDING_SUBMISSION)
  trackingNo   String?
  courier      String?
  shippedAt    DateTime?
  receivedAt   DateTime?
  receivedBy   String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  order             Order            @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customFieldValues Json?
  photos            SamplePhoto[]
  timeline          SampleTimeline[]

  @@index([orderId])
  @@index([status])
}

model SamplePhoto {
  id         String   @id @default(cuid())
  sampleId   String
  photoUrl   String
  caption    String?
  uploadedAt DateTime @default(now())
  sample     Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model SampleTimeline {
  id          String   @id @default(cuid())
  sampleId    String
  status      String
  title       String
  description String?
  operator    String?
  createdAt   DateTime @default(now())
  sample      Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Report {
  id            String             @id @default(cuid())
  reportNo      String             @unique
  orderId       String
  title         String
  summaryZh     String?
  summaryEn     String?
  fileUrl       String?
  status        ReportStatus       @default(DRAFT)
  issuedAt      DateTime?
  expiresAt     DateTime?
  watermark     Boolean            @default(false)
  downloadCount Int                @default(0)
  viewCount     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  Certificate   Certificate[]
  order         Order              @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments   ReportAttachment[]
  downloads     ReportDownload[]
  shareLinks    ReportShareLink[]

  @@index([orderId])
  @@index([reportNo])
}

model ReportAttachment {
  id        String   @id @default(cuid())
  reportId  String
  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int?
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ReportDownload {
  id           String   @id @default(cuid())
  reportId     String
  userId       String
  ipAddress    String?
  downloadedAt DateTime @default(now())
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ReportShareLink {
  id        String   @id @default(cuid())
  reportId  String
  token     String   @unique
  expiresAt DateTime
  maxViews  Int?
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Laboratory {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  nameZh               String
  nameEn               String?
  shortDescZh          String?
  shortDescEn          String?
  fullDescZh           String?
  fullDescEn           String?
  address              String?
  city                 String?
  province             String?
  phone                String?
  email                String?
  website              String?
  logo                 String?
  coverImage           String?
  certifications       Json?
  specialties          Json?
  status               LabStatus              @default(PENDING)
  rating               Decimal?               @db.Decimal(3, 2)
  completedOrders      Int                    @default(0)
  avgTurnaroundDays    Decimal?               @db.Decimal(5, 1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  CustomTestingRequest CustomTestingRequest[]
  equipment            Equipment[]
  media                LabMedia[]
  services             LabService[]
  users                LabUser[]
  orders               Order[]
  rfqs                 RFQRequest[]

  @@index([status])
}

model LabUser {
  id     String     @id @default(cuid())
  userId String     @unique
  labId  String
  role   String     @default("staff")
  lab    Laboratory @relation(fields: [labId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model LabService {
  id        String         @id @default(cuid())
  labId     String
  serviceId String
  isActive  Boolean        @default(true)
  lab       Laboratory     @relation(fields: [labId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service   TestingService @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([labId, serviceId])
  @@index([labId])
}

model LabMedia {
  id        String     @id @default(cuid())
  labId     String
  type      String
  url       String
  caption   String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  lab       Laboratory @relation(fields: [labId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Equipment {
  id                String              @id @default(cuid())
  slug              String              @unique
  labId             String?
  nameZh            String
  nameEn            String?
  model             String?
  manufacturer      String?
  descZh            String?
  descEn            String?
  specifications    Json?
  certifications    Json?
  images            Json?
  videoUrl          String?
  usageInstructions String?
  status            EquipmentStatus     @default(AVAILABLE)
  bookable          Boolean             @default(false)
  quantity          Int                 @default(1)
  hourlyRate        Decimal?            @db.Decimal(12, 2)
  dailyRate         Decimal?            @db.Decimal(12, 2)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  lab               Laboratory?         @relation(fields: [labId], references: [id], onUpdate: NoAction)
  bookings          EquipmentBooking[]
  schedule          EquipmentSchedule[]

  @@index([labId])
  @@index([status])
}

model EquipmentBooking {
  id           String    @id @default(cuid())
  equipmentId  String
  userId       String
  bookingDate  DateTime? @db.Date
  startTime    DateTime
  endTime      DateTime
  purpose      String?
  contactName  String?
  contactPhone String?
  serviceName  String?
  status       String    @default("pending")
  totalPrice   Decimal?  @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([equipmentId])
  @@index([userId])
  @@index([bookingDate])
}

model EquipmentSchedule {
  id          String    @id @default(cuid())
  equipmentId String
  type        String
  startTime   DateTime
  endTime     DateTime
  reason      String?
  createdAt   DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  balance      Decimal       @default(0) @db.Decimal(12, 2)
  frozenAmount Decimal       @default(0) @db.Decimal(12, 2)
  currency     String        @default("CNY")
  transactions Transaction[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model CompanyWallet {
  id           String        @id @default(cuid())
  companyId    String        @unique
  balance      Decimal       @default(0) @db.Decimal(12, 2)
  frozenAmount Decimal       @default(0) @db.Decimal(12, 2)
  creditLimit  Decimal       @default(0) @db.Decimal(12, 2)
  currency     String        @default("CNY")
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions Transaction[]
}

model Transaction {
  id              String          @id @default(cuid())
  walletId        String?
  companyWalletId String?
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  balanceAfter    Decimal?        @db.Decimal(12, 2)
  description     String?
  referenceType   String?
  referenceId     String?
  createdAt       DateTime        @default(now())
  companyWallet   CompanyWallet?  @relation(fields: [companyWalletId], references: [id], onUpdate: NoAction)
  wallet          Wallet?         @relation(fields: [walletId], references: [id], onUpdate: NoAction)

  @@index([walletId])
  @@index([companyWalletId])
}

model Payment {
  id            String           @id @default(cuid())
  orderId       String
  providerId    String?
  method        PaymentMethod
  amount        Decimal          @db.Decimal(12, 2)
  currency      String           @default("CNY")
  status        String           @default("pending")
  transactionId String?
  externalNo    String?
  notifyData    Json?
  verifiedAt    DateTime?
  paidAt        DateTime?
  refundedAt    DateTime?
  refundAmount  Decimal?         @db.Decimal(12, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  order         Order            @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider      PaymentProvider? @relation(fields: [providerId], references: [id], onUpdate: NoAction)

  @@index([orderId])
  @@index([providerId])
  @@index([status])
}

model Invoice {
  id               String          @id @default(cuid())
  invoiceNo        String          @unique
  orderId          String?
  invoiceProfileId String?
  type             String          @default("普通发票")
  amount           Decimal         @db.Decimal(12, 2)
  status           String          @default("pending")
  fileUrl          String?
  issuedAt         DateTime?
  createdAt        DateTime        @default(now())
  invoiceProfile   InvoiceProfile? @relation(fields: [invoiceProfileId], references: [id], onUpdate: NoAction)
