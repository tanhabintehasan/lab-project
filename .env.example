# Database (Supabase Transaction Pooler — port 6543 for runtime queries)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Database (Supabase Session Pooler / Direct — port 5432 for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth
JWT_SECRET="generate-a-256-bit-secret-and-paste-here"

# App
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_DEFAULT_LOCALE="zh-CN"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage
UPLOAD_DIR=./public/uploads

# Encryption (32+ chars, generate with: openssl rand -base64 32)
ENCRYPTION_KEY="replace-with-a-secure-32-char-key!"

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Payment (optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# AI (optional)
# MOONSHOT_API_KEY=
